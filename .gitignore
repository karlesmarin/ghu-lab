shots/
# Any throwaway browser profile, matched on the WORD and not on a prefix.  This has now caught
# the same mistake twice: first the third shooter's profile, when the list named the two that
# existed at the time, and then `.profile-slow/`, `.profile-callers/` and `.snapshot-profile/`,
# when the glob was anchored to `.shoot-` and the new harnesses did not start with it.
.*profile*/
app/
# Anchored: a bare `site/` also matches `src/site/`, which is the SOURCE and must be tracked.
# It silently dropped the whole stylesheet and every page fragment from the first commit.
/site/
__pycache__/

build/sources.local

# The browser tier's stamp is MACHINE-LOCAL EVIDENCE: it certifies that leaks/layout/extremes
# ran on THIS checkout. A clone must not inherit a certification it never earned, so it stays out
# of git and `_test_browsergate.py` handles its absence as "stale", which is the honest answer.
build/.browser_gate.json
